[Unit]
Description=rustranslator — MCP server (Streamable HTTP)
After=network.target

[Service]
Type=simple
# HTTP, not stdio: a stdio server dies with the client that spawned it.
# This mode lives on its own and answers any harness that points at the address.
ExecStart=/usr/bin/rustranslator mcp --transport http --address 127.0.0.1:9720
Restart=on-failure
RestartSec=2

StandardOutput=journal
StandardError=journal

# Hardening: the service needs only the user's configuration and the local network.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/rustranslator

[Install]
WantedBy=default.target
